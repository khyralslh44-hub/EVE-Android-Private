<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#10172c"><title>روسي خطوة — تعلّم على مهلك</title>
<style>
:root{--bg:#0b1020;--panel:#141c32;--panel2:#19243d;--stroke:#293651;--text:#f2f5ff;--muted:#9ba8c4;--mint:#91f2d0;--mint2:#49d8b0;--blue:#97b5ff;--coral:#ffb4a5;--yellow:#f4d487;--radius:24px;--shadow:0 16px 40px #0003}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Tahoma,Arial,sans-serif}body{padding:0 0 calc(92px + env(safe-area-inset-bottom));background:radial-gradient(ellipse at 90% -10%,#1d3155 0,transparent 38%),var(--bg)}button{font:inherit;cursor:pointer;border:0;color:inherit}button:focus-visible{outline:3px solid var(--mint);outline-offset:3px}.app{width:min(100%,560px);margin:auto;padding:18px 17px 24px}.topbar{display:flex;align-items:center;gap:12px;margin:4px 0 24px}.logo{width:48px;height:48px;display:grid;place-items:center;border-radius:17px;background:linear-gradient(145deg,#b4ffe6,#57d7b4);color:#12283a;font-size:13px;font-weight:900;letter-spacing:1px;box-shadow:0 7px 20px #54ddb333}.brand{flex:1}.brand h1{font-size:18px;margin:0;font-weight:850;letter-spacing:-.5px}.brand p{margin:3px 0 0;font-size:12px;color:var(--muted)}.offline{border:1px solid #34574f;background:#142e2b;color:#aaf2d8;padding:7px 9px;border-radius:100px;font-size:10px;white-space:nowrap;display:flex;align-items:center;gap:5px}.dot{width:6px;height:6px;background:var(--mint);border-radius:50%;display:inline-block}
.eyebrow{color:var(--mint);font-size:12px;font-weight:750;margin:0 0 7px}.hero{border:1px solid #304460;border-radius:28px;padding:21px 20px 19px;background:linear-gradient(132deg,#1d3150 0%,#17243d 52%,#182b37 100%);position:relative;overflow:hidden;box-shadow:var(--shadow)}.hero:after{content:"";position:absolute;width:160px;height:160px;border:1px solid #80f0d51c;border-radius:50%;left:-44px;top:-50px;box-shadow:0 0 0 22px #80f0d509,0 0 0 45px #80f0d506;pointer-events:none}.hero h2{font-size:28px;line-height:1.36;margin:0;max-width:340px;letter-spacing:-1px}.hero h2 em{font-style:normal;color:var(--mint)}.hero .sub{color:#bdc8df;font-size:13px;line-height:1.8;margin:10px 0 19px;max-width:340px}.primary{display:flex;justify-content:center;align-items:center;gap:9px;background:var(--mint);color:#102b2b;font-weight:850;border-radius:15px;padding:14px 17px;min-height:49px;box-shadow:0 7px 18px #58dcb326}.primary:active{transform:scale(.985)}.primary.full{width:100%}.primary .arrow{font-size:19px}.hero-meta{display:flex;gap:13px;margin-top:18px;color:#d1d9e9;font-size:11px}.hero-meta span{display:flex;gap:6px;align-items:center}.section-head{display:flex;justify-content:space-between;align-items:center;margin:27px 1px 13px}.section-head h2{font-size:17px;margin:0;font-weight:850}.text-bt