n{background:transparent;color:var(--mint);font-weight:750;font-size:12px;padding:7px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}.stat{border:1px solid var(--stroke);background:#131b2e;border-radius:18px;padding:13px 12px;min-width:0}.stat strong{font-size:22px;display:block;line-height:1.3;letter-spacing:-.5px}.stat span{font-size:11px;color:var(--muted);display:block;margin-top:4px}.stat .tiny-icon{float:left;color:var(--mint);font-size:15px}.section-list{display:grid;gap:10px}.lesson{display:flex;gap:12px;align-items:center;text-align:right;width:100%;background:var(--panel);border:1px solid var(--stroke);border-radius:19px;padding:13px;color:var(--text)}.lesson:active{background:var(--panel2)}.lesson-icon{height:45px;width:45px;border-radius:15px;display:grid;place-items:center;flex-shrink:0;font-size:20px;background:#263149}.lesson-main{min-width:0;flex:1}.lesson-title{font-size:13px;font-weight:800;display:block}.lesson-desc{display:block;color:var(--muted);font-size:11px;margin-top:4px}.lesson-progress{height:4px;border-radius:99px;background:#2a344a;margin-top:10px;overflow:hidden}.lesson-progress i{display:block;height:100%;background:var(--mint);border-radius:99px}.chevron{color:#8392ae;font-size:20px}.tip{border:1px solid #45402b;background:#242317;border-radius:18px;padding:15px;display:flex;gap:12px;align-items:flex-start;margin-top:19px}.tip .bulb{font-size:23px}.tip strong{font-size:12px;display:block;margin-bottom:4px;color:#f6dea1}.tip p{font-size:11px;color:#d0c9ae;line-height:1.75;margin:0}
.page-title{margin:8px 0 20px}.page-title h2{font-size:25px;letter-spacing:-.7px;margin:0}.page-title p{margin:7px 0 0;color:var(--muted);font-size:13px;line-height:1.7}.pill{display:inline-flex;border:1px solid var(--stroke);background:#151e32;color:#bac7e1;border-radius:100px;padding:7px 10px;font-size:11px;align-items:center;gap:5px}.session-top{display:flex;align-items:center;justify-content:space-between;margin:12px 0 18px}.close-btn{width:36px;height:36px;border-radius:12px;background:#1c2740;color:#c1cbe0;font-size:19px}.track{height:5px;background:#263149;border-radius:99px;overflow:hidden;flex:1;margin:0 12px}.track i{display:block;height:100%;border-radius:99px;background:var(--mint);width:0%;transition:width .25s}.word-card{border:1px solid #30415c;border-radius:27px;padding:25px 20px 21px;background:linear-gradient(150deg,#19253f,#131b2f);text-align:center;box-shadow:var(--shadow)}.small-label{font-size:11px;color:var(--muted);margin:0 0 13px}.word-ru{direction:ltr;unicode-bidi:isolate;font-weight:850;font-size:clamp(32px,9vw,43px);letter-spacing:.2px;line-height:1.35;margin:5px 0 12px}.pron{color:var(--mint);font-size:14px;font-weight:750;direction:rtl}.sound-btn{background:#26344e;color:#ccfbea;border:1px solid #3c5d5b;border-radius:100px;padding:9px 13px;font-size:12px;margin:16px 0 4px}.word-divider{height:1px;background:#2c3850;margin:20px 0 17px}.answer{animation:appear .2s ease}.meanin